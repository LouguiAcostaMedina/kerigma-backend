# ===== SGM Backend - Variables de entorno =====
# Copia este archivo a `.env` y ajusta los valores. Nunca commitees `.env`.

# Entorno y servidor
NODE_ENV=development
PORT=5000
TZ=America/Lima
API_VERSION=v1
API_BASE_PATH=/api
LOG_LEVEL=info

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Base de datos (usa DATABASE_URL en Render/Heroku; DB_* para local)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mission_system_db
DB_USER=postgres
DB_PASSWORD=password

# CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Rate limits (ms y nº de peticiones)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=100
AUTH_LOGIN_MAX_REQUESTS=5
AUTH_SIGNUP_MAX_REQUESTS=3
CHECKIN_RATE_LIMIT_WINDOW_MS=60000
CHECKIN_MAX_REQUESTS=30

# Admin inicial (npm run create-admin)
ADMIN_EMAIL=admin@sistema-misionero.com
ADMIN_FIRST_NAME=Administrador
ADMIN_LAST_NAME=Sistema
ADMIN_PHONE=
